{
  "name": "quiz-climb-api",
  "version": "1.0.0",
  "description": "Climb the tower by answering trivia questions",
  "author": "Bryan Mendones",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node create-db.js",
    "db:reset": "node scripts/db-wipe.js && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "check": "node --test",
    "db:seed": "npx sequelize-cli db:seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.3.2",
    "morgan": "^1.12.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
